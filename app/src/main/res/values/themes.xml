<resources>
    <!-- Base application theme. The app UI is Compose (ui/theme); this theme styles the window
         and the remaining View-based screens (overlays, image cropper). -->
    <style name="Base.Theme.AIScanner" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">@font/figtree</item>
    </style>

    <style name="Theme.AIScanner" parent="Base.Theme.AIScanner" />

    <!-- Invisible helper activities that only show a system dialog (screen-capture consent,
         speech recognition): no window, no dim and no animation behind the dialog. -->
    <style name="Theme.AIScanner.Translucent" parent="Base.Theme.AIScanner">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>

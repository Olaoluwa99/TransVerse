<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/all_background"
    android:id="@+id/root">


    <View
        android:layout_width="24dp"
        android:layout_height="5dp"
        android:layout_gravity="center"
        android:layout_margin="16dp"
        android:background="@color/black"/>

    <FrameLayout
        android:id="@+id/imageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/action_capture_image"
        android:layout_margin="16dp"
        android:visibility="gone"
        android:background="@drawable/floating_background">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:padding="16dp"
            android:src="@drawable/ic_baseline_photo_24" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/capture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/action_quick_capture_menu"
        android:layout_margin="16dp"
        android:background="@drawable/floating_background">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:padding="16dp"
            android:src="@drawable/ic_baseline_camera_24" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/audioText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/action_capture_speech"
        android:layout_margin="16dp"
        android:background="@drawable/floating_background"
        android:visibility="gone"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@null"
            android:padding="16dp"
            android:src="@drawable/ic_baseline_mic_24" />

    </FrameLayout>

    <FrameLayout
        android:id="@+id/close"
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:contentDescription="@string/action_close_quick_capture"
        android:layout_marginBottom="16dp"
        android:background="@drawable/close_background">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_baseline_close_24" />

    </FrameLayout>

</LinearLayout>
